# Local SQLite default: <project-root>/taskhub.db
# Set DATABASE_URL only to override the default.

# Generate a 64-character secret and store it as JWT_SECRET_KEY in local .env.
# PowerShell: use RandomNumberGenerator.Create() and convert 32 random bytes to hexadecimal.
# JWT_SECRET_KEY=<64 hexadecimal characters>
ACCESS_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL (install with: python -m pip install -e ".[postgres]")
# DATABASE_URL=postgresql+psycopg://taskhub:change-me@localhost:5432/taskhub

# MySQL (install with: python -m pip install -e ".[mysql]")
# DATABASE_URL=mysql+pymysql://taskhub:change-me@localhost:3306/taskhub
